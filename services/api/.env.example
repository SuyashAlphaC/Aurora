PORT=8000
DB_PATH=./data/aurora.db

# AI service (Member 1)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_MOCK=false

# Keep false for demo/submission — coordinator routes require a login token.
# Set true ONLY for quick debugging without any login (not for judges).
AUTH_DISABLED=false

SESSION_SECRET=change-me-in-production

# Cisco Meraki Dashboard API — developer.cisco.com/meraki/api-v1/getting-started/
# Use MERAKI_BASE_URL=https://api.meraki.in/api/v1 if your dashboard is dashboard.meraki.in (India)
MERAKI_API_KEY=
MERAKI_ORG_ID=
MERAKI_BASE_URL=https://api.meraki.com/api/v1
MERAKI_POLL_MS=60000

# Webex Bot — developer.webex.com/messaging/docs/bots
WEBEX_BOT_TOKEN=
WEBEX_SPACE_ID=
WEBEX_WEBHOOK_SECRET=

# Duo Auth API — duo.com/docs/authapi
DUO_CLIENT_ID=
DUO_CLIENT_SECRET=
DUO_API_HOST=

# ThousandEyes API v7 (optional — health probe only in PoC)
THOUSANDEYES_TOKEN=

# See docs/WEBEX_DUO_QUICKSTART.md for Duo + Webex setup
